+BEGIN SELECT RAISE(ABORT, 'guardrail results are append-only'); END;
+CREATE TRIGGER IF NOT EXISTS guardrail_result_no_delete_v2 BEFORE DELETE ON guardrail_rule_result_v2
+BEGIN SELECT RAISE(ABORT, 'guardrail results are append-only'); END;
